# بيت المطاعم | Bait Al Mataem — متغيرات البيئة
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية. لا يوجد أي قيمة افتراضية سرية هنا.

NEXT_PUBLIC_SITE_URL=https://baitalmataem.com

# Supabase (المرحلة التالية — قاعدة البيانات ولوحة الإدارة الحقيقية)
# أنشئ مشروعًا على supabase.com ثم ثبّت الحزمة: npm install @supabase/supabase-js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# حماية لوحة الإدارة (استخدم كلمة مرور طويلة وفريدة، ولا ترفع .env.local إلى Git)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Search Console (كود التحقق من الملكية عبر HTML tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# لا تُفعّل التتبع قبل تحديث سياسة الخصوصية وآلية الموافقة على ملفات الارتباط عند الحاجة
NEXT_PUBLIC_ENABLE_TRACKING=false

# WhatsApp Business (بصيغة دولية بدون + أو صفر، مثال: 9665XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
